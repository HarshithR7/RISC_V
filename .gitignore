# Python
__pycache__/
*.pyc

# Verification build output (regenerated by build_tests*.py / bench_*.py)
verify/generated/
RV64I/verify/generated/
RV64I_OOO/verify/generated/

# Synthesis working files (regenerated by RV64I/synth/*.ys)
RV64I/synth/*.mem
RV64I/synth/*.json
RV64I/synth/*.vvp
RV64I/synth/*log*.txt

# Simulation waveform dumps
*.vcd

# Stray unrelated file (not part of this project, recreated by some
# other background process/tool)
/chat.rapidgpt

# Vivado project build/cache state (regenerable by opening RISC_V.xpr and
# re-running synthesis/simulation; excluded from version control per
# standard Vivado project practice)
RISC_V.cache/
RISC_V.hw/
RISC_V.ip_user_files/
RISC_V.runs/
RISC_V.sim/
*.jou
*.log
*.pb
*.str

# xPack GCC / oss-cad-suite toolchains live outside this repo (C:\riscv-gcc,
# C:\oss-cad-suite) -- nothing here to ignore, listed for context only.
